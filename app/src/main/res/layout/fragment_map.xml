<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.geofenceoffline.map.OfflineMapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_map_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_green" />

        <TextView
            android:id="@+id/map_title_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxWidth="220dp"
            android:maxLines="1"
            android:text="Offline map"
            android:textColor="@color/text_primary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/map_zoom_in"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_zoom_button"
            android:contentDescription="Zoom in"
            android:padding="9dp"
            android:src="@drawable/ic_plus"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/map_zoom_out"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_zoom_button"
            android:contentDescription="Zoom out"
            android:padding="12dp"
            android:src="@drawable/ic_minus"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/map_locate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_zoom_button"
            android:contentDescription="Center on my location"
            android:padding="9dp"
            android:src="@drawable/ic_location"
            app:tint="@color/blue" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/map_loading"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/blue" />

    <LinearLayout
        android:id="@+id/panel_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Create a geofence"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.Geo.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap a fence to edit it, or draw a new one on this downloaded map." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_circle"
                style="@style/Widget.Geo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/circle"
                android:textSize="13sp"
                app:icon="@drawable/ic_circle"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_polygon"
                style="@style/Widget.Geo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/polygon"
                android:textSize="13sp"
                app:icon="@drawable/ic_polygon"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_fences"
                style="@style/Widget.Geo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="Manage"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/panel_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_panel"
        android:elevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panel_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="New circle geofence"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/editor_hint"
                style="@style/Text.Geo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap the map to place the centre." />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fence_name_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Geofence name"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fence_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/radius_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Radius"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/radius_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="100 m"
                        android:textColor="@color/blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/radius_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:max="200"
                    android:progress="9"
                    android:progressTint="@color/blue"
                    android:thumbTint="@color/blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/enabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enabled for scheduled checks"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/fence_enabled_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_shape"
                style="@style/Widget.Geo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="2dp"
                android:paddingStart="0dp"
                android:text="Edit shape"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_undo_point"
                    style="@style/Widget.Geo.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Undo"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_fence"
                    style="@style/Widget.Geo.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/delete"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_edit"
                    style="@style/Widget.Geo.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Cancel"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_fence"
                    style="@style/Widget.Geo.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/save"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Text.Geo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/schedule_name_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="e.g. Work hours"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/schedule_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Text.Geo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Check type" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/type_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_specific"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Specific times"
                android:textAllCaps="false"
                android:textSize="12.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_type_window"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Repeating window"
                android:textAllCaps="false"
                android:textSize="12.5sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/Text.Geo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Days of the week" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/weekday_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mon"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tue"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_wed"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_thu"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fri"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sat"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sun"
                    style="@style/Widget.Geo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sun" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/specific_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Geo.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Times of day" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/times_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_time"
                style="@style/Widget.Geo.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="Add time"
                app:icon="@drawable/ic_plus"
                app:iconSize="17dp" />

            <TextView
                style="@style/Text.Geo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Each time runs once on every selected weekday, repeating weekly." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/window_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Geo.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repeat window" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_window_start"
                    style="@style/Widget.Geo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="4:00 PM"
                    android:textSize="12.5sp"
                    app:icon="@drawable/ic_clock"
                    app:iconSize="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="to"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_window_end"
                    style="@style/Widget.Geo.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="5:00 PM"
                    android:textSize="12.5sp"
                    app:icon="@drawable/ic_clock"
                    app:iconSize="16dp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/interval_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Repeat every (minutes)"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/interval_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Text.Geo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Start and end are both included when the end aligns with the interval. For example, 4:00–5:00 every 10 minutes runs at 4:00, 4:10 … 5:00. If the end does not align, the last aligned time before it is used." />
        </LinearLayout>

        <TextView
            style="@style/Text.Geo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Geofences to check" />

        <TextView
            style="@style/Text.Geo.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="One result is stored for each enabled selected fence." />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/geofence_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:chipSpacingHorizontal="5dp" />

        <LinearLayout
            android:id="@+id/no_geofences_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_note_amber"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create a geofence before scheduling checks."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_fence"
                style="@style/Widget.Geo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingStart="0dp"
                android:text="Create a geofence"
                android:textColor="@color/amber" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_privacy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="13dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/gray" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Schedule enabled"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/enabled_hint"
                    style="@style/Text.Geo.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next runs are registered with Android AlarmManager." />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/schedule_enabled_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_schedule"
            style="@style/Widget.Geo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Save schedule"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />
    </LinearLayout>
</ScrollView>
